# =============================================================================
# CocktailBot - PayPal-Zugangsdaten
#
# SO BENUTZT DU DIESE DATEI:
#  1) Diese Datei auf dem PC ausfuellen (echte Werte eintragen).
#  2) In   paypal.env   umbenennen (ohne ".example").
#  3) Neben cocktailbot-setup.sh auf den USB-Stick legen.
#  -> Bei der Installation wird sie automatisch nach
#     /etc/cocktailbot/paypal.env uebernommen (nur root lesbar, 0600).
#
# Die echte paypal.env landet NIE im Git-Repo (durch .gitignore gesperrt).
# Werte ohne Anfuehrungszeichen eintragen, kein Leerzeichen um das "=".
# =============================================================================

# Start-Umgebung (laesst sich spaeter in der App unter Einstellungen -> Preise
# -> PayPal jederzeit zwischen "sandbox" und "live" umschalten):
COCKTAILBOT_PAYPAL_MODE=sandbox

# Name, der dem Kunden beim Bezahlen angezeigt wird (Leerzeichen erlaubt):
COCKTAILBOT_PAYPAL_BRAND_NAME=n3rdz CocktailBot

# --- Sandbox-Zugangsdaten (zum Testen) --------------------------------------
# Aus dem PayPal Developer Dashboard, App im Bereich "Sandbox".
COCKTAILBOT_PAYPAL_SANDBOX_CLIENT_ID=HIER_SANDBOX_CLIENT_ID
COCKTAILBOT_PAYPAL_SANDBOX_CLIENT_SECRET=HIER_SANDBOX_CLIENT_SECRET

# --- Live-Zugangsdaten (echtes Geld) ----------------------------------------
# Aus dem PayPal Developer Dashboard, App im Bereich "Live".
COCKTAILBOT_PAYPAL_LIVE_CLIENT_ID=HIER_LIVE_CLIENT_ID
COCKTAILBOT_PAYPAL_LIVE_CLIENT_SECRET=HIER_LIVE_CLIENT_SECRET

# Hinweis: Du kannst beide Saetze eintragen und in der App umschalten. Wenn du
# nur einen brauchst, den anderen einfach leer/als Platzhalter lassen.
#
# Alternativ (nur EIN Satz fuer beide Umgebungen) gaebe es die generischen
# Variablen - normalerweise NICHT noetig, wenn die obigen gesetzt sind:
#COCKTAILBOT_PAYPAL_CLIENT_ID=
#COCKTAILBOT_PAYPAL_CLIENT_SECRET=

# Optional: feste Rueckkehr-URLs. Normalerweise LEER lassen - die App setzt
# automatisch die richtige LAN-Adresse des Pi ein.
#COCKTAILBOT_PAYPAL_RETURN_URL=
#COCKTAILBOT_PAYPAL_CANCEL_URL=
