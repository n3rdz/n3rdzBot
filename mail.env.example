# =============================================================================
# CocktailBot - Mail-Einstellungen fuer den Backup-Versand (optional)
#
# Hier kannst du ALLE SMTP-Angaben vorab hinterlegen, damit sie nach der
# Installation schon da sind. In der App (Einstellungen -> Backup) bleibt alles
# weiter aenderbar - ein dort gespeicherter Wert hat Vorrang vor dieser Datei.
#
# SO BENUTZT DU DIESE DATEI:
#  1) Werte ausfuellen.
#  2) In   mail.env   umbenennen (ohne ".example").
#  3) Neben cocktailbot-setup.sh auf den USB-Stick legen.
#  -> Wird bei der Installation nach /etc/cocktailbot/mail.env uebernommen.
#
# Die echte mail.env landet NIE im Git-Repo. Werte ohne Anfuehrungszeichen.
# =============================================================================

MAIL_HOST=smtp.all-inkl.com
MAIL_PORT=587
# Sicherheit: starttls (Port 587), ssl (Port 465) oder none
MAIL_SECURITY=starttls
MAIL_USER=invoice@n3rdz.de
MAIL_FROM=invoice@n3rdz.de
MAIL_TO=ich@example.de
MAIL_PASSWORD=HIER_SMTP_PASSWORT
